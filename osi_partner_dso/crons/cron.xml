<?xml version="1.0" encoding='UTF-8'?>
<odoo>
    <record id="res_partner_dso_cron" model="ir.cron">
        <field name="name">Res Partner: Calcul des DSO Clients</field>
        <field name="model_id" ref="model_res_partner_dso"/>
        <field name="state">code</field>
        <field name="code">model.compute_partner_dso()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
    <record id="res_partner_authorized_exceeding_cron" model="ir.cron">
        <field name="name">Res Partner: Calcul dépassements autorisés</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.compute_all_marges()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
    <record id="compute_single_partner_dso_action_server" model="ir.actions.server">
        <field name="name">Calcul des DSO Clients</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="osi_partner_dso.model_res_partner_dso"/>
        <field name="state">code</field>
        <field name="code">
                    action = records.compute_single_partner_dso()</field>
    </record>
    <record id="compute_all_marges_action_server" model="ir.actions.server">
        <field name="name">Calcul dépassements autorisés</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">if records:
                    action = records.compute_marge()</field>
    </record>
</odoo>